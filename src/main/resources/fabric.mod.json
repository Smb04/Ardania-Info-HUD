{
	"schemaVersion": 1,
	"id": "ardania_hud",
	"version": "${version}",
	"name": "Ardania Info HUD",
	"description": "Client-seitiges Info-HUD fuer Ardania.de: Euronen (inkl. Live-Job-Einnahmen), ArdaPoints sowie Job & Joblevel.",
	"authors": [
		"Sven"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/ardania_hud/icon.png",
	"environment": "client",
	"mixins": [
		"ardania_hud.mixins.json"
	],
	"entrypoints": {
		"client": [
			"de.ardania.hud.ArdaniaClientMod"
		],
		"modmenu": [
			"de.ardania.hud.ArdaniaModMenuApiImpl"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_dep}",
		"minecraft": "${mc_dep}",
		"java": ">=${java_dep}",
		"fabric-api": "*"
